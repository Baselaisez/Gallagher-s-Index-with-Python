# Finans360 sunucusu için systemd birimi.
# Kurulum: sudo cp finans360.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now finans360
# Dosyalar /opt/finans360/finans360 altında, veriler /var/lib/finans360 altında durur.
[Unit]
Description=Finans360 sunucusu (izin, toplantı, personel)
After=network.target

[Service]
Type=simple
User=finans360
Group=finans360
WorkingDirectory=/opt/finans360/finans360/server
ExecStart=/usr/bin/node --no-warnings server.js
Environment=PORT=8360
Environment=HOST=127.0.0.1
Environment=TRUST_PROXY=1
Environment=DATA_DIR=/var/lib/finans360
StateDirectory=finans360
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3

# Sertleştirme: süreç yalnız veri klasörüne yazabilir.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
