{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "A source manifest: a printing of a treatise and how its matn is read",
 "type": "object",
 "required": [
  "id",
  "title",
  "author",
  "files",
  "matn_size",
  "header_size",
  "first_matn_page",
  "glyphs",
  "sections",
  "status",
  "rights"
 ],
 "definitions": {
  "tri": {
   "type": "object",
   "required": [
    "ar",
    "en",
    "tr"
   ],
   "properties": {
    "ar": {
     "type": "string"
    },
    "en": {
     "type": "string"
    },
    "tr": {
     "type": "string"
    }
   },
   "additionalProperties": false
  }
 },
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9-]+$"
  },
  "title": {
   "$ref": "#/definitions/tri"
  },
  "author": {
   "$ref": "#/definitions/tri"
  },
  "files": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   }
  },
  "matn_size": {
   "type": "integer",
   "minimum": 1
  },
  "header_size": {
   "type": "integer",
   "minimum": 1
  },
  "first_matn_page": {
   "type": "integer",
   "minimum": 1
  },
  "last_matn_page": {
   "type": "integer",
   "minimum": 1
  },
  "glyphs": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "opaque_ranges": {
   "type": "array",
   "items": {
    "type": "array",
    "minItems": 2,
    "items": {
     "type": "string",
     "pattern": "^[0-9A-F]{4}$"
    }
   }
  },
  "opaque_mark": {
   "type": "string"
  },
  "sections": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "key",
     "start",
     "ar",
     "en",
     "tr"
    ],
    "properties": {
     "key": {
      "type": "string"
     },
     "start": {
      "type": "integer",
      "minimum": 1
     },
     "ar": {
      "type": "string"
     },
     "en": {
      "type": "string"
     },
     "tr": {
      "type": "string"
     }
    },
    "additionalProperties": false
   }
  },
  "rule_sections": {
   "type": "object",
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "string"
    }
   }
  },
  "rule_terms": {
   "type": "object",
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "string"
    }
   }
  },
  "role_sections": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "status": {
   "type": "string",
   "enum": [
    "raw-unreviewed",
    "collated",
    "reviewed"
   ]
  },
  "rights": {
   "type": "string"
  }
 },
 "additionalProperties": false
}