{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "A Qissa law table (derivation)",
 "type": "object",
 "required": [
  "version",
  "title",
  "note",
  "roles",
  "babs",
  "why",
  "patterns",
  "rules"
 ],
 "definitions": {
  "tri": {
   "type": "object",
   "required": [
    "ar",
    "en",
    "tr"
   ],
   "properties": {
    "ar": {
     "type": "string"
    },
    "en": {
     "type": "string"
    },
    "tr": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "override": {
   "type": "object",
   "required": [
    "tpl",
    "why"
   ],
   "properties": {
    "tpl": {
     "type": "string",
     "pattern": "[ء-ي]"
    },
    "why": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "cite": {
   "type": "object",
   "required": [
    "source",
    "section",
    "pages"
   ],
   "properties": {
    "source": {
     "type": "string"
    },
    "section": {
     "type": "string"
    },
    "pages": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     }
    }
   },
   "additionalProperties": false
  },
  "pattern": {
   "type": "object",
   "required": [
    "id",
    "bab",
    "roles",
    "tpl"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9-]+$"
    },
    "bab": {
     "type": "integer",
     "minimum": 1
    },
    "roles": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     }
    },
    "tpl": {
     "type": "string",
     "pattern": "[ء-ي]"
    },
    "vowelled": {
     "type": "boolean"
    },
    "sound_ayn": {
     "type": "boolean"
    },
    "sama": {
     "type": "boolean"
    },
    "needs_verb": {
     "type": "boolean"
    },
    "over": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/definitions/override"
     }
    }
   }
  }
 },
 "properties": {
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "title": {
   "type": "object"
  },
  "note": {
   "type": "string"
  },
  "roles": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/definitions/tri"
   }
  },
  "babs": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "mazi",
     "name"
    ],
    "properties": {
     "mazi": {
      "type": "string"
     },
     "name": {
      "$ref": "#/definitions/tri"
     },
     "sense": {
      "$ref": "#/definitions/tri"
     }
    },
    "additionalProperties": false
   }
  },
  "why": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/definitions/tri"
   }
  },
  "rules": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/definitions/tri"
   }
  },
  "patterns": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/definitions/pattern"
   }
  }
 },
 "additionalProperties": false
}