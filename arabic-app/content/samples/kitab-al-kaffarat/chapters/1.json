            "ism-mawsul"
          ],
          "irab": {
            "ar": "اللَّامُ حَرْفُ جَرٍّ، وَ«مَا» اسْمٌ مَوْصُولٌ مَبْنِيٌّ فِي مَحَلِّ جَرٍّ.",
            "en": "The lam is a jarr letter; «ma» is a relative noun in the position of jarr.",
            "tr": "ل cer harfi; «مَا» mahallen mecrûr ism-i mevsûldür."
          }
        },
        {
          "surface": {
            "full": "يُسْتَرُ",
            "smart": "يُسْتَرُ",
            "bare": "يستر"
          },
          "lex": "satara",
          "pos": "verb",
          "grammar": [
            "naib-al-fail",
            "mudari-marfu"
          ],
          "irab": {
            "ar": "فِعْلٌ مُضَارِعٌ مَبْنِيٌّ لِلْمَجْهُولِ مَرْفُوعٌ، وَالْجُمْلَةُ صِلَةُ الْمَوْصُولِ.",
            "en": "Passive present verb in raf'; the clause is the sila of the relative.",
            "tr": "Meçhul muzâri, merfû; cümle sıla cümlesidir."
          }
        },
