            "en": "Khabar in raf', marked by damma.",
            "tr": "Merfû haber; ref alâmeti zammedir."
          }
        },
        {
          "surface": {
            "full": "لِمَا",
            "smart": "لِمَا",
            "bare": "لما"
          },
          "lex": "ma-mawsula",
