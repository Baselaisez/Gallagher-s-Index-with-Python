            "en": "Deputy subject in raf', marked by damma.",
            "tr": "Merfû nâib-i fâil; ref alâmeti zammedir."
          }
        },
        {
          "surface": {
            "full": "وَيُمْحَى",
            "smart": "وَيُمْحَى",
            "bare": "ويمحى"
