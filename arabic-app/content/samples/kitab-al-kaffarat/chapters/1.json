  "sentences": [
    {
      "id": "s1",
      "translation": {
        "en": "The kaffara is the name for that by which a sin is covered over and effaced.",
        "tr": "Keffâret, günahın kendisiyle örtüldüğü ve silindiği şeyin adıdır."
      },
      "tokens": [
        {
          "surface": {
            "full": "الْكَفَّارَةُ",
            "smart": "الْكَفَّارَةُ",
            "bare": "الكفارة"
          },
          "lex": "kaffara",
          "pos": "noun",
          "grammar": [
            "mubtada-khabar",
            "sighat-mubalagha"
          ],
          "irab": {
            "ar": "مُبْتَدَأٌ مَرْفُوعٌ وَعَلَامَةُ رَفْعِهِ الضَّمَّةُ.",
            "en": "Mubtada in raf', marked by damma.",
            "tr": "Merfû mübteda; ref alâmeti zammedir."
          }
        },
