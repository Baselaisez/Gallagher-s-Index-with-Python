            "naqis-verbs",
            "naib-al-fail"
          ],
          "irab": {
            "ar": "الْوَاوُ عَاطِفَةٌ، فِعْلٌ مُضَارِعٌ مَبْنِيٌّ لِلْمَجْهُولِ مَرْفُوعٌ بِضَمَّةٍ مُقَدَّرَةٍ عَلَى الْأَلِفِ، وَنَائِبُ الْفَاعِلِ مُسْتَتِرٌ.",
            "en": "Coupled by waw; passive present in raf' with the damma implied on the alif, its deputy subject hidden.",
            "tr": "Vav atıftır; meçhul muzâri, elif üzerinde mukadder zamme ile merfû; nâib-i fâili gizlidir."
          }
        }
      ]
    },
    {
