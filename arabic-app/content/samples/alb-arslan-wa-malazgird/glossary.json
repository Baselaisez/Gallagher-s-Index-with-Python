  "alb": {
   "lemma": "أَلْب",
   "pos": "propn",
   "gloss": {
    "en": "Alp — Turkish «hero, valiant»: the first word of the name Alp Arslan (spoken with a quiescent end; the case shows on أَرْسَلَان)",
    "tr": "Alp — Türkçe «yiğit, kahraman»: Alparslan adının ilk kelimesi (sonu sâkin okunur; i'râb أَرْسَلَان üzerinde görünür)"
   },
   "level": 6
  },
  "alb-arslan": {
   "lemma": "أَلْب أَرْسَلَان",
   "pos": "phrase",
   "level": 6,
   "gloss": {
    "en": "Alp Arslan — the Seljuk sultan (r. 455–465 / 1063–1072), victor of Manzikert (463 / 1071)",
    "tr": "Alparslan — Selçuklu sultanı (s. 455–465 / 1063–1072), Malazgirt'in galibi (463 / 1071)"
   },
   "literal": {
    "en": "literally «hero lion» (Turkish)",
    "tr": "lafzen «yiğit aslan» (Türkçe)"
   },
   "note": {
    "en": "A compound Turkish name written as two words. The whole name fills one seat in the sentence; the first word is spoken with a quiescent end and the case shows only on the last, أَرْسَلَان — a diptote (ʿalamiyya + ʿujma): أَرْسَلَانُ in raf', أَرْسَلَانَ in nasb and in jarr alike, never with tanwin.",
    "tr": "İki kelime olarak yazılan birleşik bir Türkçe isim. İsmin bütünü cümlede tek bir görev üstlenir; ilk kelime sâkin okunur, i'râb yalnızca sondaki أَرْسَلَان üzerinde görünür — gayr-i munsarif (alemiyet + ucmet): refte أَرْسَلَانُ, nasb ve cerde aynı şekilde أَرْسَلَانَ, asla tenvin almaz."
   }
  },
