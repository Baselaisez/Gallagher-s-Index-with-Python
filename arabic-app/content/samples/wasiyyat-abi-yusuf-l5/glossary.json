    "bayna-yadayh": {
      "lemma": "بَيْنَ يَدَيْهِ",
      "pos": "phrase",
      "level": 3,
      "gloss": {
        "en": "in his presence, before him",
        "tr": "huzurunda, önünde"
      },
      "literal": {
        "en": "literally «between his two hands»",
        "tr": "lafzen «iki eli arasında»"
      },
      "note": {
        "en": "A fixed idiom for being in someone's presence, and the ordinary way to say it of a ruler or a teacher. The two words keep their own i'rab — بَيْنَ is a mansub zarf and يَدَيْهِ its mudaf ilayh — but they are read together.",
        "tr": "Birinin huzurunda bulunmayı anlatan yerleşik bir deyimdir; sultan veya hoca için kullanılan olağan ifadedir. İki kelime kendi i'rabını korur — بَيْنَ mansub zarf, يَدَيْهِ onun muzâfun ileyhidir — fakat birlikte okunur."
      }
    }
