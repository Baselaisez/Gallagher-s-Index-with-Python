    "al-bayt-al-haram": {
      "lemma": "الْبَيْتُ الْحَرَامُ",
      "pos": "phrase",
      "level": 3,
      "gloss": {
        "en": "the Sacred House (the Kaaba)",
        "tr": "Beytü'l-Harâm (Kâbe)"
      },
      "literal": {
        "en": "literally «the inviolable house»",
        "tr": "lafzen «dokunulmaz ev»"
      },
      "note": {
        "en": "A name for the Kaaba. Grammatically it is a noun with its adjective, and the story's «بَيْتَهُ الْحَرَامَ» shows the rule at work: the noun is definite through its pronoun, so its na't takes ال.",
        "tr": "Kâbe'nin adıdır. Gramer bakımından mevsûf ve sıfattır; hikâyedeki «بَيْتَهُ الْحَرَامَ» kuralı gösterir: isim zamirle marife olduğu için sıfatı ال alır."
      }
    }
